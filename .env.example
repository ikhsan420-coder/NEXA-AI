# ============================================================
# NEXA AI - backend configuration
# Copy this file to ".env" and fill in your own values.
#   cp .env.example .env
# NEVER commit ".env" and NEVER put the key in frontend code.
# ============================================================

# REQUIRED. Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Server
PORT=8787
HOST=0.0.0.0
NODE_ENV=development

# OPTIONAL: extra browser origins allowed to call the API (comma separated).
# Needed when the frontend is hosted on a different domain than this backend.
# Capacitor/Android origins (https://localhost, capacitor://localhost) are already allowed.
CORS_ORIGINS=

# OPTIONAL: limit the model picker to these model IDs (comma separated).
# Leave empty to show every chat model that Groq reports for your account.
GROQ_MODELS=

# OPTIONAL: default model ID. Must exist in the live Groq model list.
GROQ_DEFAULT_MODEL=

# OPTIONAL: cap on generated tokens per answer (empty = model default).
MAX_OUTPUT_TOKENS=

# OPTIONAL: requests per minute per IP.
CHAT_RATE_LIMIT=30
API_RATE_LIMIT=120

# OPTIONAL: set to 1 when running behind a reverse proxy (Nginx, Railway...) so rate limiting
# sees the real client IP. Not needed on Vercel (set automatically).
TRUST_PROXY=

# OPTIONAL: replace the built-in system prompt.
NEXA_SYSTEM_PROMPT=

# ------------------------------------------------------------
# Frontend build-time variable (NOT a secret). Used by the Android/Capacitor build
# so the app knows where your deployed backend lives. Example: https://nexa-api.example.com
# VITE_API_BASE_URL=
